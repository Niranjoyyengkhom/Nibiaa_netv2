{
    email {$ACME_EMAIL:admin@nibiaa.com}
    servers {
        protocols h1 h2
    }
}

# Redirect direct IP access to primary domain
http://34.122.43.248, 34.122.43.248 {
    redir https://nibiaanet.nibiaa.com{uri} permanent
}

# Official Public SSL (Let's Encrypt / ZeroSSL)
nibiaanet.nibiaa.com, nibiaaplaxx.nibiaa.com {
    # Dedicated Hubble Network Webhook endpoints -> backend
    handle /webhooks* {
        reverse_proxy backend:3000
    }

    # Protocol Ingestion Microservice generic webhooks
    handle /webhook {
        reverse_proxy protocol_ingestion:1002
    }
    handle /webhook/* {
        reverse_proxy protocol_ingestion:1002
    }
    handle /ingest* {
        reverse_proxy protocol_ingestion:1002
    }
    handle /endpoints* {
        reverse_proxy protocol_ingestion:1002
    }

    # Core Backend REST API
    handle_path /api/* {
        reverse_proxy backend:3000
    }

    # Microservice reverse proxies
    handle_path /decoder/* {
        reverse_proxy decoder:3001
    }
    handle_path /iam/* {
        reverse_proxy iam:3002
    }
    handle_path /billing-service/* {
        reverse_proxy billing:3003
    }

    # Frontend Dashboard Web Console
    handle {
        reverse_proxy frontend:8080 {
            header_up Host {upstream_hostport}
        }
    }
}
