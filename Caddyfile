# NibiaaNet Production Domains (Official Domain & Direct IP-DNS)
nibiaanet.nibiaa.com, http://nibiaanet.nibiaa.com, 34.122.43.248.nip.io, http://34.122.43.248.nip.io {
    # Webhook Ingestion endpoints for Hubble Network and 3rd party gateways
    handle /webhook* {
        reverse_proxy protocol_ingestion:1002
    }
    handle /ingest* {
        reverse_proxy protocol_ingestion:1002
    }
    handle /webhooks/* {
        reverse_proxy backend:3000
    }
    handle /endpoints* {
        reverse_proxy protocol_ingestion:1002
    }

    # Core Backend REST API
    handle_path /api/* {
        reverse_proxy backend:3000
    }

    # Microservice reverse proxies
    handle_path /decoder/* {
        reverse_proxy decoder:3001
    }
    handle_path /iam/* {
        reverse_proxy iam:3002
    }
    handle_path /billing-service/* {
        reverse_proxy billing:3003
    }

    # Frontend Dashboard Web Console
    handle {
        reverse_proxy frontend:8080
    }
}
