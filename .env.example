# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=device_registry

# Backend Security
JWT_SECRET_KEY=nibiaanet_jwt_secret_production_key_369

# Ports & Hosts (Container mapped defaults)
BACKEND_PORT=3000
DECODER_PORT=3001
IAM_PORT=3003
FRONTEND_PORT=8080
UDP_PORT=5005
POSTGRES_PORT=5432
REDIS_PORT=6379
CASSANDRA_PORT=9042
