# NibiaaNet Decoder Service v2 (PostgreSQL Required)
PORT=3001
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# PostgreSQL Database Connection
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/device_registry

# Execution timeout in milliseconds
DECODER_TIMEOUT_MS=500

# UDP Ingestion Port
UDP_PORT=5005
UDP_INGEST_ENABLED=true

# MQTT Ingestion (Optional)
# MQTT_URL=mqtt://localhost:1883
# MQTT_TOPIC=uplink/#
