# NibiaaNet Backend v2 Environment Configuration (PostgreSQL Required)
PORT=3002
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002

# PostgreSQL Database Connection
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/device_registry

# Dedicated Billing Database (All data encrypted at rest)
BILLING_DATABASE_NAME=billing
BILLING_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/billing

# Authentication
JWT_SECRET_KEY=change_this_to_a_secure_random_key_for_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Credentials Encryption Key (Fernet AES-256)
# CREDENTIALS_ENCRYPTION_KEY=

# Decoder Microservice URL
DECODER_SERVICE_URL=http://127.0.0.1:3001

# 1NCE Cellular Network Provider (https://help.1nce.com/api/)
ONCE_API_BASE_URL=https://api.1nce.com/management-api
ONCE_CLIENT_ID=
ONCE_CLIENT_SECRET=
ONCE_SANDBOX_MODE=true

# Monogoto Cellular Network Provider (https://developer.monogoto.io/overview)
MONOGOTO_API_BASE_URL=https://api.monogoto.io
MONOGOTO_USERNAME=
MONOGOTO_PASSWORD=
MONOGOTO_SANDBOX_MODE=true

# Odoo ERP Invoicing & Billing Integration
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USERNAME=admin
ODOO_PASSWORD=
ODOO_MOCK_MODE=true

